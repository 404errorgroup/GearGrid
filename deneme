              onClick={() => mainRef.current?.scrollBy({ top: 260, behavior: "smooth" })}
              style={{ ...btn, position: "absolute", bottom: 12, left: "50%", transform: "translateX(-50%)", width: 44, height: 44, borderRadius: "50%",
                border: 0, background: C.ink, boxShadow: "0 2px 8px rgba(0,0,0,.3)", display: "flex", alignItems: "center", justifyContent: "center", padding: 0 }}>
              <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><path d="M6 9l6 6 6-6" /></svg>
            </button>
          )}
        </div>
        <nav style={{ position: "relative", flex: "none", display: "flex", justifyContent: "space-around", background: "#fff", borderTop: `1px solid ${C.line}`, padding: "8px 8px 16px" }}>
          {tabs.map(([k, l]) => (
            <button key={k} onClick={() => setTab(k)} aria-current={tab === k ? "page" : undefined}
              style={{ ...btn, minWidth: 80, minHeight: 48, background: "none", border: 0, fontSize: 13, fontWeight: tab === k ? 700 : 400, color: tab === k ? C.acc : C.mute }}>
              {l}
            </button>
          ))}
        </nav>
      </div>
    </div>
  );
}
