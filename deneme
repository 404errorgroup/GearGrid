// Koordinattan il adı bulur, bulamazsa "Konumun" döner
async function cityName(lat, lon) {
  try {
    const r = await fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${lat}&longitude=${lon}&localityLanguage=tr`);
    const d = await r.json();
    return d.principalSubdivision || d.city || "Konumun";
  } catch { return "Konumun"; }
}

async function fetchWeather(lat, lon) {
  const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}` +
    `&current=temperature_2m,relative_humidity_2m,wind_speed_10m,weather_code,precipitation&daily=uv_index_max&timezone=auto`;
  const r = await fetch(url);
  if (!r.ok) throw new Error("Hava verisi alınamadı");
  const d = await r.json();
  const c = d.current;
  const temp = Math.round(c.temperature_2m);
  return {
    temp,
    wind: Math.round(c.wind_speed_10m),
    humidity: Math.round(c.relative_humidity_2m),
    uv: Math.round(d.daily.uv_index_max[0]),
    rain: c.precipitation > 0 || (c.weather_code >= 51 && c.weather_code <= 99 && !(c.weather_code >= 71 && c.weather_code <= 77)),
    label: codeLabel(c.weather_code, temp),
  };
}

// Konumu otomatik bulur, izin verilmezse Muğla kullanır
function useWeather() {
  const [state, setState] = useState({ status: "loading", w: null, place: "" });
  useEffect(() => {
    let alive = true, timer, hasData = false;
    const load = async (loc) => {
      try {
        const w = await fetchWeather(loc.lat, loc.lon);
        hasData = true;
        if (alive) setState({ status: "ok", w, place: loc.name });
      } catch {
        // Konumun havası alınamazsa Muğla gösterilir
        if (!hasData && loc !== DEFAULT_LOC) return load(DEFAULT_LOC);
        // Yenileme başarısız olursa son bilinen veri kalır
        if (alive) setState((p) => (p.w ? p : { status: "error", w: null, place: loc.name }));
      }
    };
    const start = (loc) => { load(loc); timer = setInterval(() => load(loc), 10 * 60 * 1000); };
    if (!navigator.geolocation) start(DEFAULT_LOC);
    else navigator.geolocation.getCurrentPosition(
      async (p) => start({ lat: p.coords.latitude, lon: p.coords.longitude, name: await cityName(p.coords.latitude, p.coords.longitude) }),
      () => start(DEFAULT_LOC),
      { timeout: 6000 }
    );
    return () => { alive = false; clearInterval(timer); };
  }, []);
  return state;
}

