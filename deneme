// Hava durumuna göre ek ürünler ve nedenleri
function weatherGear(w) {
  const out = [];
  if (w.temp <= 10) out.push(["Eldiven", `${w.temp}° soğukta ellerin uyuşmasın`]);
  if (w.temp <= 10) out.push(["Boyunluk", "Rüzgâr soğuğu daha çok hissettirir"]);
  if (w.wind >= 20) out.push(["Rüzgâr geçirmez mont", `Rüzgâr ${w.wind} km/s`]);
  if (w.uv >= 7) out.push(["Güneş kremi SPF 50+", `UV ${w.uv}, 2 saatte bir yenile`]);
  if (w.temp >= 28) out.push(["Su matarası 2 L", `${w.temp}° sıcakta sıvı kaybı artar`]);
  if (w.rain) out.push(["Su geçirmez ceket", "Yağış bekleniyor"]);
  return out;
}

function verdict(level, w) {
  const novice = level === "baslangic";
  if (w.rain) return "Yağış var. Yeni başlayanlar için ertelemeyi düşün.";
  if (novice && w.wind >= 22) return "Rüzgâr güçlü. Yeni başlayanlar için uygun değil.";
  return "Koşullar uygun. Sabah saatleri daha güvenli.";
}

