function Gear({ s, w, level, owned, toggleOwn, gender }) {
  const novice = level === "baslangic";
  const items = [...SPORTS[s].base, ...(novice ? (BEGINNER_EXTRA[s] || []) : [])];
  const names = items.map(([n]) => n);
  const extras = (w ? weatherGear(w) : []).filter(([n]) => !names.includes(n)); // zaten listede olanı tekrarlama
  const why = Object.fromEntries(extras);
  const all = [...items, ...extras.map(([n]) => [n, "wx"])];
  const done = all.filter(([n]) => owned[n]).length;
  const group = (t, title) => (
    <>
      <h2 style={{ margin: 0, padding: "14px 20px 6px", fontSize: 14, color: C.mute }}>{title}</h2>
      <div style={{ display: "flex", flexDirection: "column", gap: 8, padding: "0 20px" }}>
        {all.filter(([, x]) => x === t).map(([n]) => (
          <label key={n} style={{ display: "flex", alignItems: "center", gap: 12, background: (owned[n] ? OWNED : TINT[t])[0], border: `1px solid ${(owned[n] ? OWNED : TINT[t])[1]}`, borderRadius: 14, padding: "12px 14px", minHeight: 56, cursor: "pointer" }}>
            <input type="checkbox" checked={!!owned[n]} onChange={() => toggleOwn(n)} style={{ width: 22, height: 22, accentColor: C.acc }} />
            <span style={{ flex: 1, color: t === "wx" && !owned[n] ? "#fff" : C.ink }}>
              <span style={{ display: "block", fontSize: 15, textDecoration: owned[n] ? "line-through" : "none" }}>{n}</span>
              {t === "wx" && <span style={{ display: "block", fontSize: 12, marginTop: 2, color: owned[n] ? "#1F3A2B" : "#D5D9DE" }}>{why[n]}</span>}
            </span>
          </label>
        ))}
