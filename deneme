// Konum alınamazsa varsayılan: Muğla (Fethiye koordinatları)
const DEFAULT_LOC = { lat: 36.62, lon: 29.11, name: "Muğla" };

function codeLabel(c, temp) {
  if (c >= 95) return "Fırtına";
  if (c >= 80) return "Sağanak yağış";
  if (c >= 61) return "Yağmurlu";
  if (c >= 51) return "Çiseleme";
  if (c >= 71 && c <= 77) return "Karlı";
  if (c >= 45) return "Sisli";
  if (c === 3) return "Kapalı";
  if (c >= 1) return "Parçalı bulutlu";
  return temp >= 28 ? "Sıcak ve güneşli" : "Açık";
}

